{
  "name": "rewryjs",
  "version": "0.0.0-alpha.3",
  "description": "Rewrite any npm package, just in browser.",
  "keywords": [
    "front-end",
    "esm",
    "loader",
    "rewrite",
    "runtime"
  ],
  "homepage": "https://github.com/shc0743/rewry#readme",
  "bugs": {
    "url": "https://github.com/shc0743/rewry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shc0743/rewry.git"
  },
  "license": "MIT",
  "author": "chcs1013",
  "type": "module",
  "main": "./dist/rewry.js",
  "types": "./dist/rewry.d.ts",
  "files": [
    "src/**",
    "dist/**",
    "README.md",
    "tsconfig.*",
    "tsdown.config.ts",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/rewry.d.ts",
        "default": "./dist/rewry.js"
      },
      "require": {
        "types": "./dist/rewry.d.cts",
        "default": "./dist/rewry.cjs"
      }
    }
  },
  "unpkg": "./dist/rewry.umd.min.js",
  "jsdelivr": "./dist/rewry.umd.min.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "only-allow pnpm && tsdown --watch",
    "build": "only-allow pnpm && pnpm type-check && pnpm build-only && pnpm bundle",
    "build-only": "tsdown",
    "bundle": "rolldown dist/rewry.js --minify --file dist/rewry.min.js && rolldown dist/rewry.js --minify --format umd --name rewry --file dist/rewry.umd.min.js",
    "type-check": "only-allow pnpm && tsc --noEmit"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@pnpm/lockfile.types": "^1002.1.0",
    "add-css-constructed": "^1.1.3",
    "mime-db": "^1.54.0",
    "modern-tar": "^0.7.6",
    "parse-package-name": "^1.0.0",
    "resolve.exports": "^2.0.3",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.5.0",
    "@types/semver": "^7.7.1",
    "idb": "^8.0.3",
    "npm-run-all2": "^8.0.4",
    "only-allow": "^1.2.2",
    "rolldown": "^1.0.0-rc.12",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3"
  }
}
